{
  "name": "shell-nft-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible Shell-native NFT dApp for testing Shell Chain smart contracts.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "mint": "node scripts/mint.mjs",
    "read": "node scripts/read.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/compile.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shell-sdk": "^0.10.0",
    "viem": "^2.39.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "solc": "^0.8.30",
    "typescript": "^5.9.0",
    "vite": "7.2.4"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
